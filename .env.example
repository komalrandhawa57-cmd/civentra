# Copy these values into your local shell environment before starting the app.
CIVENTRA_DB_URL=jdbc:oracle:thin:@//localhost:1521/XEPDB1
CIVENTRA_DB_USERNAME=CIVENTRA_USER
CIVENTRA_DB_PASSWORD=replace-with-your-local-oracle-password
CIVENTRA_DB_POOL_SIZE=10
CIVENTRA_AI_ENABLED=false
CIVENTRA_AI_API_KEY=
CIVENTRA_AI_MODEL=gpt-4o-mini
CIVENTRA_AI_ENDPOINT=https://api.openai.com/v1/responses
CIVENTRA_STORAGE_UPLOAD_DIR=C:/civentra-data/uploads
SERVER_PORT=8081
CIVENTRA_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
CIVENTRA_MAP_ATTRIBUTION=© OpenStreetMap contributors
